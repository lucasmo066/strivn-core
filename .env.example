# Required: server-only database credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY (do not set both)

# Optional email notifications. Leads are saved even if email is unavailable.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Private inbox link to include in owner notifications (Supabase Table Editor or Notion).
CONTACT_LEADS_URL=

# Optional Notion mirror. Configure the exact database properties in docs/lead-intake.md.
NOTION_TOKEN=
NOTION_PIPELINE_DATABASE_ID=

# Optional deployment override for the public Calendly event used by /book.
CALENDLY_URL=https://calendly.com/lucas-strivnagency/30min

# Confirmed live project URL. Real screenshots are configured in lib/sahara.ts.
SAHARA_SITE_URL=
